{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "briefvu-tools",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_URL": "https://briefvu.com"
  },
  "routes": [
    { "pattern": "briefvu.com", "custom_domain": true },
    { "pattern": "www.briefvu.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
