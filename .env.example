# Server-side only. Configure with `wrangler secret put OPENAI_API_KEY` in production.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
# Used only to hash network identifiers for abuse prevention. Use a random secret in production.
RATE_LIMIT_SALT=replace-with-a-long-random-value
# Public canonical origin. Use the final HTTPS custom domain when it is connected.
SITE_URL=https://briefvu.com
# Optional URL-prefix Search Console verification token. Do not include the full meta tag.
GOOGLE_SITE_VERIFICATION=
